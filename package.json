{
  "name": "sanity-plugin-editor-onboarding",
  "version": "1.0.0",
  "description": "Interactive, unobtrusive onboarding tours for Sanity Studio editors \u2014 with a zero-config library of core Sanity concepts.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "onboarding",
    "tour",
    "walkthrough",
    "guide",
    "studio"
  ],
  "homepage": "https://github.com/Henkisch/sanity-plugin-editor-onboarding#readme",
  "bugs": {
    "url": "https://github.com/Henkisch/sanity-plugin-editor-onboarding/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Henkisch/sanity-plugin-editor-onboarding.git"
  },
  "license": "MIT",
  "author": "Henrik Larsson <henrik@kodamera.se>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./init": {
      "source": "./src/init/index.ts",
      "default": "./dist/init.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "SKILL.md"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "check:links": "node scripts/check-docs-links.mjs",
    "dev": "npm run dev --workspace test-studio",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint src",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.1.1"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^12.3.4",
    "@sanity/plugin-kit": "^10.0.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.12.0",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": "^19.2",
    "sanity": "^6.0.0-0",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./init": "./dist/init.js",
      "./package.json": "./package.json"
    }
  },
  "browserslist": "extends @sanity/browserslist-config",
  "workspaces": [
    "test-studio"
  ],
  "sanityPlugin": {
    "verifyPackage": {
      "tsconfig": false
    }
  },
  "bin": {
    "sanity-plugin-editor-onboarding": "./bin/cli.mjs"
  }
}
